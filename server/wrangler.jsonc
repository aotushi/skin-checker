{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skin-checker-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  },

  // R2:用户图片临时存储,分析后即删,见 ../docs/adr/0003-image-ephemeral-storage.md
  "r2_buckets": [{ "binding": "IMG_BUCKET", "bucket_name": "skin-checker-img" }],

  // D1:只存结构化历史,不存原图。database_id 为占位,本地 `--local` 用 database_name 定位;
  // 远程需先 `wrangler d1 create skin-checker`(用户同意后)拿真 id 替换。
  "d1_databases": [{ "binding": "DB", "database_name": "skin-checker", "database_id": "local" }]
}
