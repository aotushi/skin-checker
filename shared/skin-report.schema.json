{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skin-checker/shared/skin-report.schema.json",
  "title": "SkinReport",
  "description": "皮肤分析结果契约 —— 三端共用 + 千问VL 结构化输出约束的单一真相源",
  "type": "object",
  "additionalProperties": false,
  "required": ["skinType", "confidence", "zones", "suggestions", "disclaimer"],
  "properties": {
    "skinType": {
      "type": "string",
      "enum": ["干性", "油性", "混合性", "敏感性"],
      "description": "综合判断的肤质类型"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "置信度 0-1"
    },
    "zones": {
      "type": "array",
      "description": "分区评估",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "issues", "score"],
        "properties": {
          "area": {
            "type": "string",
            "description": "分区名,如 T区 / 脸颊"
          },
          "issues": {
            "type": "array",
            "items": { "type": "string" },
            "description": "该区问题点"
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10,
            "description": "分区评分 0-10,供卡片可视化"
          }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "护肤建议"
    },
    "disclaimer": {
      "type": "string",
      "description": "免责声明标准文案(三端结果页/启动页统一展示):本结果由 AI 生成,仅供护肤参考,不构成医疗建议,严重皮肤问题请就医。"
    }
  }
}
