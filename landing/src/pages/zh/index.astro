---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Features from '../../components/Features.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Download from '../../components/Download.astro';
import TechStack from '../../components/TechStack.astro';
import Compliance from '../../components/Compliance.astro';
import Footer from '../../components/Footer.astro';
import { zh } from '../../i18n/zh';

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonicalUrl = `${site}/zh/`;
const hreflangZh = canonicalUrl;
const hreflangEn = `${site}/en/`;
---

<Base t={zh} canonicalUrl={canonicalUrl} hreflangEn={hreflangEn} hreflangZh={hreflangZh}>
  <Nav t={zh} />
  <main>
    <Hero t={zh} />
    <Features t={zh} />
    <HowItWorks t={zh} />
    <Download t={zh} />
    <TechStack t={zh} />
    <Compliance t={zh} />
  </main>
  <Footer t={zh} />
</Base>
