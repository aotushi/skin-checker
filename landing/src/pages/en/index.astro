---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Features from '../../components/Features.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import Download from '../../components/Download.astro';
import TechStack from '../../components/TechStack.astro';
import Compliance from '../../components/Compliance.astro';
import Footer from '../../components/Footer.astro';
import { en } from '../../i18n/en';

const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonicalUrl = `${site}/en/`;
const hreflangZh = `${site}/zh/`;
const hreflangEn = canonicalUrl;
---

<Base t={en} canonicalUrl={canonicalUrl} hreflangEn={hreflangEn} hreflangZh={hreflangZh}>
  <Nav t={en} />
  <main>
    <Hero t={en} />
    <Features t={en} />
    <HowItWorks t={en} />
    <Download t={en} />
    <TechStack t={en} />
    <Compliance t={en} />
  </main>
  <Footer t={en} />
</Base>
