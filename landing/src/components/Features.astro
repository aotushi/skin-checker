---
import type { Strings } from '../i18n/zh';

interface Props {
  t: Strings;
}
const { t } = Astro.props;
// 四卡浅底轮换,取科普四维卡 tint(与应用端同 token)
const tints = ['var(--tint-gold)', 'var(--tint-clay)', 'var(--tint-rose)', 'var(--tint-brown)'];
---

<section id="features">
  <div class="container">
    <p class="sec-label">{t.features.label}</p>
    <h2 class="sec-title">{t.features.title}</h2>
    <p class="sec-sub">{t.features.sub}</p>

    <div class="feats">
      {
        t.features.items.map((item, i) => (
          <article class="card feat">
            <span class="feat__num" style={`background:${tints[i % tints.length]}`}>
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="feat__t">{item.t}</h3>
            <p class="feat__d">{item.d}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .feats {
    margin-top: 36px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .feat {
    padding: 24px;
  }
  .feat__num {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    color: var(--rose-deep);
    padding: 5px 12px;
    border-radius: 10px;
    margin-bottom: 14px;
  }
  .feat__t {
    font-size: 17px;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .feat__d {
    font-size: 14px;
    line-height: 1.7;
    color: var(--muted);
  }

  @media (max-width: 640px) {
    .feats {
      grid-template-columns: 1fr;
    }
  }
</style>
